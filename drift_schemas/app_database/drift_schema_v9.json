  "fixed_sql": [
    {
      "name": "floor_plans",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"floor_plans\" (\"id\" INTEGER NOT NULL, \"json\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "placements",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"placements\" (\"device_id\" TEXT NOT NULL, \"kind\" TEXT NOT NULL, \"x\" REAL NOT NULL, \"y\" REAL NOT NULL, PRIMARY KEY (\"device_id\"));"
        }
      ]
    },
    {
      "name": "plants",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"plants\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"every_days\" INTEGER NOT NULL, \"last_watered\" TEXT NOT NULL, \"previous_watered\" TEXT NULL, \"photo_path\" TEXT NULL, \"fertilize_every_weeks\" INTEGER NULL, \"last_fertilized\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "speaker_settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"speaker_settings\" (\"id\" TEXT NOT NULL, \"display_name\" TEXT NULL, \"hidden\" INTEGER NOT NULL DEFAULT 0 CHECK (\"hidden\" IN (0, 1)), \"is_default\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_default\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "zen_settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"zen_settings\" (\"id\" INTEGER NOT NULL, \"idle_minutes\" INTEGER NOT NULL DEFAULT 5, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "plant_profiles",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"plant_profiles\" (\"plant_id\" TEXT NOT NULL, \"species_id\" INTEGER NULL, \"source\" TEXT NOT NULL DEFAULT 'perenual', \"common_name\" TEXT NOT NULL, \"scientific_name\" TEXT NULL, \"image_url\" TEXT NULL, \"watering\" TEXT NULL, \"watering_min_days\" INTEGER NULL, \"watering_max_days\" INTEGER NULL, \"watering_winter_min_days\" INTEGER NULL, \"watering_winter_max_days\" INTEGER NULL, \"fertilize_every_weeks\" INTEGER NULL, \"sunlight\" TEXT NOT NULL DEFAULT '', \"care_level\" TEXT NULL, \"indoor\" INTEGER NULL CHECK (\"indoor\" IN (0, 1)), \"poisonous_to_pets\" INTEGER NULL CHECK (\"poisonous_to_pets\" IN (0, 1)), \"pruning_months\" TEXT NOT NULL DEFAULT '', \"watering_guide\" TEXT NULL, \"sunlight_guide\" TEXT NULL, \"pruning_guide\" TEXT NULL, \"fetched_at\" TEXT NOT NULL, PRIMARY KEY (\"plant_id\"));"
        }
