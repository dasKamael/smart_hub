<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The hub is dark in light and dark mode alike: black start screen with the logo. Android 12+ uses the
         splash screen attributes in values-v31. Removed when Flutter draws its first frame. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Behind the Flutter UI while it starts and runs. Black, so nothing flashes white. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@android:color/black</item>
    </style>
</resources>
